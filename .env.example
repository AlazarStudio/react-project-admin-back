# Значения в закомментированных строках совпадают с умолчаниями в коде —
# раскомментируйте, только если нужно другое.

NODE_ENV=dev
PORT=5000

DATABASE_URL="postgresql://user:password@localhost:5432/dbname?schema=public"

JWT_SECRET=change-me

# Ключ для приёма заявок с сайта: POST /api/leads, заголовок x-api-key
SITE_API_KEY=change-me

# Пароль администратора. Используется prisma/seed.js ТОЛЬКО при создании
# учётки (login: admin). Если админ уже есть, сид его не трогает.
# Если переменную не задать, сид сгенерирует пароль и напечатает его один раз.
SEED_ADMIN_PASSWORD=change-me

# Дополнительные origin'ы для CORS через запятую.
# По умолчанию уже разрешены localhost:3000, localhost:3199, 127.0.0.1:3199,
# localhost:5173.
# CORS_ORIGINS=https://admin.example.com

# За обратным прокси (nginx): без этого в Lead.ip попадёт адрес прокси,
# а ограничение частоты будет считать всех посетителей одним клиентом.
# TRUST_PROXY=1

# Хосты, которым PUT /api/config может отправить обновление config.json.
# Пусто — исходящий запрос не делается вовсе (защита от SSRF).
# CONFIG_SYNC_ALLOWED_HOSTS=mayak-modul.ru,www.mayak-modul.ru

# Ограничения загрузки медиа и размера тела запроса
# MAX_UPLOAD_BYTES=15728640
# JSON_BODY_LIMIT=1mb

# Ограничение частоты (в памяти процесса).
# На входе считаются ТОЛЬКО неудачные попытки, успешный вход обнуляет счётчик.
# LOGIN_RATE_LIMIT_MAX=20
# LOGIN_RATE_LIMIT_WINDOW_MS=900000
# LEAD_RATE_LIMIT_MAX=20
# LEAD_RATE_LIMIT_WINDOW_MS=600000

# Корень сайта для `npm run seed:export` (пересборка prisma/seed-data.json).
# Обычному запуску `npm run seed` не нужен — он читает готовый снимок.
# SITE_ROOT=/var/www/mayak

# Только для production (сервер поднимается по HTTPS)
# SSL_CERT_PATH=/etc/letsencrypt/live/your-domain/fullchain.pem
# SSL_KEY_PATH=/etc/letsencrypt/live/your-domain/privkey.pem
